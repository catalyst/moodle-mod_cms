{{!
    @template mod_cms/type_preview

    The preview of a CMS type on the type edit form, framed like an activity card in a course page.
    The activity-item markup follows core_courseformat/local/content/cm and may need adjusting for each Moodle release.

    Example context (json):
    {
        "hint": "Preview (click \"Save changes and display\" to update)",
        "content": "<p>Rendered content</p>"
    }
}}
<div class="cms-type-preview mb-4">
    <div class="text-muted mb-2">{{hint}}</div>
    <div class="activity-item">
        {{{content}}}
    </div>
</div>
