{{!
    @template mod_cms/type_edit_layout

    Content type edit page: a sticky navigation column in the page margin to the left of the form.

    Example context (json):
    {
        "toc": [{"text": "General", "url": "#fitem_id_name"}],
        "form": "<form></form>"
    }
}}
<div class="position-relative cms-type-edit">
    <nav class="d-none d-xxl-block position-absolute top-0 bottom-0 end-100 me-3" style="width: 14rem;"
         aria-label="{{#str}} sections, mod_cms {{/str}}">
        <ul class="nav flex-column position-sticky" style="top: 9rem;">
            {{#toc}}
                <li class="nav-item"><a class="nav-link ps-0" href="{{url}}">{{{text}}}</a></li>
            {{/toc}}
        </ul>
    </nav>
    {{{form}}}
</div>
